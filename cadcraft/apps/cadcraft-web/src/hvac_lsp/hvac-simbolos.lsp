    ((= id "EQ-FILTRO_DESHIDRATADOR")
     (gs-p (list (list (- hx) 0.0) (list 0.0 (* 0.8 hy)) (list hx 0.0) (list 0.0 (* -0.8 hy))) T) (gs-l (* -0.5 hx) (* -0.4 hy) (* 0.5 hx) (* 0.4 hy)) (gs-l (* -0.5 hx) (* 0.4 hy) (* 0.5 hx) (* -0.4 hy)))
