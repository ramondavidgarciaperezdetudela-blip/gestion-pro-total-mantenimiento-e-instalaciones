;;; Símbolos de planta de Gestión Pro Total para CADCraft: dibujos reconocibles de cada equipo
;;; (no cajas con letras). Unidades: metros. Cada símbolo se dibuja dentro de su bloque, centrado en 0,0.

(setq gs-pi 3.14159265358979)
(defun gs-rad (g) (* g (/ gs-pi 180.0)))

;; ── Primitivas ────────────────────────────────────────────────────────────────
(defun gs-l (x1 y1 x2 y2)
  (entmake (list (cons 0 "LINE") (cons 8 "0") (list 10 x1 y1 0.0) (list 11 x2 y2 0.0))))
(defun gs-p (pts cerrada)
  (entmake (append (list (cons 0 "LWPOLYLINE") (cons 100 "AcDbEntity") (cons 8 "0") (cons 100 "AcDbPolyline")
                         (cons 90 (length pts)) (cons 70 (if cerrada 1 0)))
                   (mapcar '(lambda (p) (list 10 (car p) (cadr p))) pts))))
(defun gs-r (x1 y1 x2 y2) (gs-p (list (list x1 y1) (list x2 y1) (list x2 y2) (list x1 y2)) T))
(defun gs-c (x y r) (entmake (list (cons 0 "CIRCLE") (cons 8 "0") (list 10 x y 0.0) (cons 40 r))))
(defun gs-a (x y r a1 a2)
  (entmake (list (cons 0 "ARC") (cons 8 "0") (list 10 x y 0.0) (cons 40 r) (cons 50 (gs-rad a1)) (cons 51 (gs-rad a2)))))
(defun gs-t (x y h txt)
  (entmake (list (cons 0 "TEXT") (cons 8 "0") (list 10 x y 0.0) (list 11 x y 0.0) (cons 40 h) (cons 1 txt) (cons 72 1) (cons 73 2))))

;; ── Piezas reutilizables ──────────────────────────────────────────────────────
;; Ventilador axial: aro, buje y tres palas curvas.
(defun gs-vent (x y r / i a c)
  (setq c (list x y) i 0)
  (gs-c x y r) (gs-c x y (* 0.14 r))
  (repeat 3
    (setq a (* i 2.0943951))
    (gs-p (list (polar c a (* 0.16 r)) (polar c (+ a 0.30) (* 0.55 r)) (polar c (+ a 0.20) (* 0.92 r))
                (polar c (+ a 0.75) (* 0.80 r)) (polar c (+ a 0.85) (* 0.45 r)) (polar c (+ a 0.55) (* 0.16 r))) T)
    (setq i (1+ i))))
;; Ventilador centrífugo: voluta en espiral y rodete.
(defun gs-centrif (x y r / i)
  (gs-a x y r 0 270)
  (gs-p (list (list (+ x r) y) (list (+ x r) (- y (* 1.15 r))) (list x (- y (* 1.15 r))) (list x (- y r))) nil)
  (gs-c x y (* 0.55 r)) (gs-c x y (* 0.12 r))
  (setq i 0)
  (repeat 8 (gs-l (+ x (* 0.14 r (cos (* i 0.785398)))) (+ y (* 0.14 r (sin (* i 0.785398))))
                  (+ x (* 0.55 r (cos (+ 0.4 (* i 0.785398))))) (+ y (* 0.55 r (sin (+ 0.4 (* i 0.785398))))))
    (setq i (1+ i))))
;; Aletas del serpentín (líneas paralelas)
(defun gs-aletas (x1 y1 x2 y2 n vertical / i f)
  (setq i 1)
  (repeat (1- n)
    (setq f (/ (float i) n))
    (if vertical
      (gs-l (+ x1 (* f (- x2 x1))) y1 (+ x1 (* f (- x2 x1))) y2)
      (gs-l x1 (+ y1 (* f (- y2 y1))) x2 (+ y1 (* f (- y2 y1)))))
    (setq i (1+ i))))
;; Zigzag (serpentín de tubo, muelle)
(defun gs-zig (x1 x2 y n amp / pts i)
  (setq pts (list (list x1 y)) i 1)
  (repeat n
    (setq pts (append pts (list (list (+ x1 (* (- x2 x1) (/ (- i 0.5) n))) (+ y (if (= (rem i 2) 1) amp (- amp)))))))
    (setq i (1+ i)))
  (gs-p (append pts (list (list x2 y))) nil))
;; Válvula (dos triángulos enfrentados) con eje
(defun gs-valv (x y s / h)
  (setq h (* 0.6 s))
  (gs-p (list (list (- x s) (+ y h)) (list (- x s) (- y h)) (list (+ x s) (+ y h)) (list (+ x s) (- y h))) T)
  (gs-l (- x (* 1.4 s)) y (- x s) y) (gs-l (+ x s) y (+ x (* 1.4 s)) y))
;; Flecha desde (x1,y1) hacia (x2,y2)
(defun gs-flecha (x1 y1 x2 y2 / a c)
  (setq a (angle (list x1 y1) (list x2 y2)) c (* 0.35 (distance (list x1 y1) (list x2 y2))))
  (gs-l x1 y1 x2 y2)
  (gs-p (list (polar (list x2 y2) (+ a 2.8) c) (list x2 y2) (polar (list x2 y2) (- a 2.8) c)) nil))
;; Cápsula (depósito horizontal)
(defun gs-capsula (x1 y1 x2 y2 / r)
  (setq r (/ (- y2 y1) 2.0))
  (gs-l (+ x1 r) y1 (- x2 r) y1) (gs-l (+ x1 r) y2 (- x2 r) y2)
  (gs-a (+ x1 r) (+ y1 r) r 90 270) (gs-a (- x2 r) (+ y1 r) r -90 90))
;; Rejilla: cuadrado con lamas en diagonal
(defun gs-rejilla (hx hy / i)
  (gs-r (- hx) (- hy) hx hy) (gs-r (* -0.78 hx) (* -0.78 hy) (* 0.78 hx) (* 0.78 hy))
  (setq i -2)
  (repeat 5 (gs-l (* -0.78 hx) (* (* 0.39 i) hy) (* 0.78 hx) (* (+ (* 0.39 i) 0.78) hy)) (setq i (1+ i))))

;; ── Dibujo de cada equipo ─────────────────────────────────────────────────────
;; id = nombre del bloque (EQ-...), w y h = tamaño en metros.
(defun gs-dibuja (id w h / hx hy r)
  (setq hx (/ w 2.0) hy (/ h 2.0) r (* 0.9 (min hx hy)))
  (cond
    ;; ── Refrigeración ──
    ((= id "EQ-COMPRESOR")
     (gs-r (- hx) (- hy) hx hy) (gs-c (* -0.2 w) 0.0 (* 0.34 h)) (gs-c (* -0.2 w) 0.0 (* 0.12 h))
     (gs-r (* 0.15 w) (* -0.3 h) (* 0.42 w) (* 0.3 h)) (gs-l (* 0.15 w) 0.0 (* 0.42 w) 0.0)
     (gs-l (* 0.3 w) hy (* 0.3 w) (* 0.3 h)) (gs-l (* 0.05 w) hy (* 0.05 w) (* 0.34 h)))
    ((= id "EQ-CONDENSADOR")
     (gs-r (- hx) (- hy) hx hy) (gs-aletas (- hx) (- hy) (* -0.55 hx) hy 6 T)
     (gs-vent (* 0.22 hx) 0.0 (* 0.62 hy)) (gs-l (* -0.55 hx) (- hy) (* -0.55 hx) hy))
    ((= id "EQ-CONDENSADORA_AIRE")
     (gs-r (- hx) (- hy) hx hy) (gs-vent (* -0.45 hx) 0.0 (* 0.78 hy)) (gs-vent (* 0.45 hx) 0.0 (* 0.78 hy))
