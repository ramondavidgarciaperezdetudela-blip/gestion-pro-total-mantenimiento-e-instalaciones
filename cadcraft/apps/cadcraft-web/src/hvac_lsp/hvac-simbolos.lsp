     (gs-flecha (* -0.5 hx) (* 0.3 hy) (* -0.5 hx) (* 0.9 hy)) (gs-flecha (* 0.5 hx) (* 0.3 hy) (* 0.5 hx) (* 0.9 hy)))
    ((= id "EQ-ARCON")
     (gs-r (- hx) (- hy) hx hy) (gs-r (* -0.9 hx) (* -0.75 hy) (* 0.9 hx) (* 0.75 hy)) (gs-l (- hx) hy (* 0.9 hx) (* 0.75 hy)) (gs-l hx hy (* 0.9 hx) (* 0.75 hy))
     (gs-t 0.0 0.0 (* 0.3 h) "*"))
    ((= id "EQ-ABATIDOR")
     (gs-r (- hx) (- hy) hx hy) (gs-r (* -0.8 hx) (* -0.8 hy) (* 0.8 hx) (* 0.8 hy)) (gs-vent 0.0 0.0 (* 0.5 hy))
     (gs-l (* -0.8 hx) (* 0.5 hy) (* -0.55 hx) (* 0.5 hy)) (gs-l (* 0.55 hx) (* -0.5 hy) (* 0.8 hx) (* -0.5 hy)))
    ((= id "EQ-BOTELLERO")
     (gs-r (- hx) (- hy) hx hy) (gs-r (* -0.96 hx) (* -0.8 hy) (* 0.96 hx) (* 0.8 hy))
     (gs-c (* -0.78 hx) 0.0 (* 0.12 hy)) (gs-c (* -0.52 hx) 0.0 (* 0.12 hy)) (gs-c (* -0.26 hx) 0.0 (* 0.12 hy)) (gs-c 0.0 0.0 (* 0.12 hy))
