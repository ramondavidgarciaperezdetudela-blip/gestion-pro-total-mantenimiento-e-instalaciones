    ((= id "EQ-CONDENSADORA_CENTRIFUGO")
     (gs-r (- hx) (- hy) hx hy) (gs-centrif (* -0.4 hx) (* 0.15 hy) (* 0.5 hy)) (gs-aletas (* 0.15 hx) (- hy) hx hy 7 T)
     (gs-l (* 0.15 hx) (- hy) (* 0.15 hx) hy))
    ((= id "EQ-CONDENSADORA_AGUA")
     (gs-r (- hx) (- hy) hx hy) (gs-zig (* -0.8 hx) (* 0.8 hx) (* 0.45 hy) 6 (* 0.22 hy)) (gs-zig (* -0.8 hx) (* 0.8 hx) (* -0.1 hy) 6 (* 0.22 hy))
     (gs-zig (* -0.8 hx) (* 0.8 hx) (* -0.65 hy) 6 (* 0.18 hy))
     (gs-flecha (- hx) (* 0.45 hy) (* -0.8 hx) (* 0.45 hy)) (gs-flecha (* 0.8 hx) (* -0.65 hy) hx (* -0.65 hy)))
    ((= id "EQ-CONDENSADORA_EVAPORATIVA")
