(defun gpt-colocar (id capa / ang p n)
  (gpt-cargar-biblioteca)
  (setq ang (getangle "\nGiro en grados <0>: "))
  (if (not ang) (setq ang 0.0))
  (while (setq p (getpoint "\nPunto de colocación (Intro para terminar): "))
    (entmake (list (cons 0 "INSERT") (cons 8 capa) (cons 2 id) (list 10 (car p) (cadr p) 0.0) (cons 41 1.0) (cons 42 1.0) (cons 43 1.0) (cons 50 ang)))
    (princ (strcat "\nColocado: " id)))
  (princ))

