(defun gpt-capa (nombre color)
  (if (not (tblsearch "LAYER" nombre))
    (entmake (list (cons 0 "LAYER") (cons 100 "AcDbSymbolTableRecord") (cons 100 "AcDbLayerTableRecord") (cons 2 nombre) (cons 70 0) (cons 62 color) (cons 6 "Continuous")))))

(defun gpt-linea (a b / ) (entmake (list (cons 0 "LINE") (cons 8 "0") (cons 10 a) (cons 11 b))))

(defun gpt-def-bloque (nombre w h glyph color / x y)
  (if (not (tblsearch "BLOCK" nombre))
    (progn
      (setq x (/ w 2.0) y (/ h 2.0))
      (entmake (list (cons 0 "BLOCK") (cons 2 nombre) (cons 70 0) (list 10 0.0 0.0 0.0)))
      (gpt-linea (list (- x) (- y) 0.0) (list x (- y) 0.0))
      (gpt-linea (list x (- y) 0.0) (list x y 0.0))
      (gpt-linea (list x y 0.0) (list (- x) y 0.0))
      (gpt-linea (list (- x) y 0.0) (list (- x) (- y) 0.0))
      (gpt-linea (list (- x) (- y) 0.0) (list x y 0.0))
      (gpt-linea (list (- x) y 0.0) (list x (- y) 0.0))
      (entmake (list (cons 0 "TEXT") (cons 8 "0") (list 10 0.0 0.0 0.0) (list 11 0.0 0.0 0.0) (cons 40 (* 0.3 (min w h))) (cons 1 glyph) (cons 72 1) (cons 73 2)))
      (entmake (list (cons 0 "ENDBLK"))))))

