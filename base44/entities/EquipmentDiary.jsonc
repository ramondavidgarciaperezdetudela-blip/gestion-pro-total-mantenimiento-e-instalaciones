{
  "name": "EquipmentDiary",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "machine_name": {
      "type": "string"
    },
    "machine_type": {
      "type": "string",
      "enum": [
        "aire_acondicionado",
        "bomba_calor",
        "camara_frigorifica",
        "ventilacion",
        "caldera",
        "aerotermia",
        "solar_fotovoltaico",
        "solar_termico",
        "electrico_cuadro",
        "grupo_frio",
        "otro"
      ],
      "default": "otro"
    },
    "equipment_brand": {
      "type": "string"
    },
    "equipment_model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "description": "Entradas del diario de reparaciones",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "type": {
            "type": "string",
            "enum": [
              "reparacion",
              "mantenimiento",
              "revision",
              "instalacion",
              "averia",
              "otro"
            ],
            "default": "reparacion"
          },
          "technician": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "solution": {
            "type": "string"
          },
          "parts_used": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          },
          "hours": {
            "type": "number"
          },
          "photos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string"
          },
          "next_action_date": {
            "type": "string",
            "format": "date"
          },
          "photo_names": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Qué es cada foto (mismo orden que photos)"
          },
          "signature_technician": {
            "type": "string",
            "description": "Firma del técnico (base64)"
          },
          "sign_datetime_technician": {
            "type": "string",
            "description": "Fecha y hora de la firma del técnico"
          },
          "signature_client": {
            "type": "string",
            "description": "Firma del cliente (base64)"
          },
          "sign_datetime_client": {
            "type": "string",
            "description": "Fecha y hora de la firma del cliente"
          },
          "ficha_id": {
            "type": "string",
            "description": "Ficha de mantenimiento de la que salió esta entrada; sirve para actualizarla en vez de duplicarla al volver a guardar"
          },
          "ficha_numero": {
            "type": "string",
            "description": "Número de esa ficha"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "equipment_power_kw": {
      "type": "string",
      "description": "Potencia del equipo (kW o CV)"
    },
    "equipment_year": {
      "type": "string",
      "description": "Año del equipo"
    },
    "equipment_refrigerant": {
      "type": "string",
      "description": "Refrigerante que lleva"
    },
    "equipment_photo_url": {
      "type": "string",
      "description": "Foto del equipo o de su placa"
    },
    "warranty_expires": {
      "type": "string",
      "description": "Hasta cuándo está en garantía"
    }
  },
  "required": [
    "contact_id",
    "contact_name"
  ]
}