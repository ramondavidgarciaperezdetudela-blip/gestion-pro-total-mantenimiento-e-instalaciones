{
  "name": "PlanoCatalogItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del elemento/maquinaria personalizada"
    },
    "cat": {
      "type": "string",
      "enum": [
        "refrigeracion",
        "clima",
        "ventilacion",
        "electrico",
        "seguridad",
        "estructura",
        "ia"
      ],
      "description": "Categor\u00eda (apartado) del cat\u00e1logo al que pertenece. 'ia' es el apartado de iconos generados por IA."
    },
    "glyph": {
      "type": "string",
      "description": "C\u00f3digo corto de 2-3 letras para identificar el s\u00edmbolo"
    },
    "w_m": {
      "type": "number",
      "description": "Ancho en metros",
      "default": 0.6
    },
    "h_m": {
      "type": "number",
      "description": "Alto en metros",
      "default": 0.6
    },
    "precio": {
      "type": "number",
      "description": "Precio orientativo (\u20ac)"
    },
    "image_url": {
      "type": "string",
      "description": "URL del icono/imagen generado por IA para el s\u00edmbolo"
    },
    "std_id": {
      "type": "string",
      "description": "Identificador del s\u00edmbolo est\u00e1ndar del cat\u00e1logo al que corresponde este icono IA. Vac\u00edo = elemento propio del usuario (no es la versi\u00f3n IA de un s\u00edmbolo de f\u00e1brica)."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "cat"
  ],
  "rls": {
      "create": {
          "$or": [
              {
                  "created_by_id": "{{user.id}}"
              },
              {
                  "user_condition": {
                      "role": "admin"
                  }
              }
          ]
      },
      "read": {
          "$or": [
              {
                  "created_by_id": "{{user.id}}"
              },
              {
                  "user_condition": {
                      "role": "admin"
                  }
              }
          ]
      },
      "update": {
          "$or": [
              {
                  "created_by_id": "{{user.id}}"
              },
              {
                  "user_condition": {
                      "role": "admin"
                  }
              }
          ]
      },
      "delete": {
          "$or": [
              {
                  "created_by_id": "{{user.id}}"
              },
              {
                  "user_condition": {
                      "role": "admin"
                  }
              }
          ]
      }
  }
}
