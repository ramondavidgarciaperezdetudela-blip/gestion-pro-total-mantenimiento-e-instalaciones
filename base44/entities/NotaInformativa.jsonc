{
  "name": "NotaInformativa",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Texto de la nota (texto plano, párrafos separados por línea en blanco)"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "enviada"
      ],
      "default": "borrador"
    },
    "audience": {
      "type": "string",
      "enum": [
        "todos",
        "seleccionados"
      ]
    },
    "sent_date": {
      "type": "string"
    },
    "made_with_ai": {
      "type": "boolean"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    }
  }
}