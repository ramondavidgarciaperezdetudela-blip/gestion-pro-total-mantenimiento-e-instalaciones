{
  "name": "RefrigerationPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del plano"
    },
    "contact_id": {
      "type": "string",
      "description": "ID del cliente vinculado"
    },
    "contact_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del proyecto"
    },
    "scale": {
      "type": "number",
      "description": "P\u00edxeles por metro (escala del lienzo)",
      "default": 50
    },
    "walls": {
      "type": "array",
      "description": "Paredes como segmentos (coordenadas en p\u00edxeles del lienzo)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "description": "Equipos, aparamenta, seguridad, ventilaci\u00f3n y estructura colocados en el plano",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "Identificador del cat\u00e1logo (compresor, condensadora_aire, rejilla_impulsion, etc.)"
          },
          "cat": {
            "type": "string",
            "description": "Categor\u00eda: refrigeracion, clima, ventilacion, electrico, seguridad, estructura"
          },
          "label": {
            "type": "string"
          },
          "glyph": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w_m": {
            "type": "number"
          },
          "h_m": {
            "type": "number"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "default": 1
          },
          "datos": {
            "type": "object",
            "description": "Campos t\u00e9cnicos propios del equipo (potencia, refrigerante, tensi\u00f3n, etc.)",
            "additionalProperties": true
          }
        }
      }
    },
    "connections": {
      "type": "array",
      "description": "Tuber\u00edas refrigerantes, conductos de ventilaci\u00f3n y conexiones el\u00e9ctricas entre equipos",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "refrigerante",
              "electrica",
              "conducto"
            ]
          },
          "from_id": {
            "type": "string",
            "description": "ID del elemento de origen"
          },
          "to_id": {
            "type": "string",
            "description": "ID del elemento de destino"
          },
          "path": {
            "type": "array",
            "description": "Puntos intermedios (codos) como polil\u00ednea: [{x,y}, ...]. Vac\u00edo = l\u00ednea recta.",
            "items": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          },
          "gas_diameter": {
            "type": "string",
            "description": "Di\u00e1metro de la l\u00ednea de gas (refrigerante)"
          },
          "liquid_diameter": {
            "type": "string",
            "description": "Di\u00e1metro de la l\u00ednea de l\u00edquido (refrigerante)"
          },
          "power_w": {
            "type": "string",
            "description": "Potencia que mueve la conexi\u00f3n (W)"
          },
          "voltage": {
            "type": "string"
          },
          "height_m": {
            "type": "string",
            "description": "Desnivel de la tuber\u00eda (m)"
          },
          "power_type": {
            "type": "string",
            "description": "Tipo de conexi\u00f3n de potencia (el\u00e9ctrica)"
          },
          "comm_type": {
            "type": "string",
            "description": "Tipo de conexi\u00f3n de comunicaciones (el\u00e9ctrica)"
          },
          "conn_kind": {
            "type": "string",
            "description": "Subtipo de conexi\u00f3n el\u00e9ctrica: potencia o comunicacion"
          },
          "section_mm2": {
            "type": "string",
            "description": "Secci\u00f3n del cable (mm\u00b2)"
          },
          "cable": {
            "type": "string"
          },
          "duct_section": {
            "type": "string",
            "description": "Secci\u00f3n del conducto (mm)"
          },
          "duct_shape": {
            "type": "string",
            "description": "Forma del conducto: Rectangular, Circular, Flexible"
          },
          "duct_caudal_m3h": {
            "type": "string",
            "description": "Caudal del conducto (m\u00b3/h)"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "string",
      "description": "Notas del plano"
    },
    "vista3d_url": {
      "type": "string",
      "description": "Archivo PNG de la vista 3D del plano, guardado junto a \u00e9l y regenerado cuando cambia el dibujo"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "enviado",
        "cerrado",
        "cancelado"
      ],
      "default": "borrador"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}