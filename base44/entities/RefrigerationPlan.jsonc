{
  "name": "RefrigerationPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre del plano"
    },
    "contact_id": {
      "type": "string",
      "description": "ID del cliente vinculado"
    },
    "contact_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del proyecto"
    },
    "scale": {
      "type": "number",
      "description": "P\u00edxeles por metro (escala del lienzo)",
      "default": 50
    },
    "walls": {
      "type": "array",
      "description": "Paredes como segmentos (coordenadas en p\u00edxeles del lienzo)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "description": "Equipos, aparamenta, seguridad y estructura colocados en el plano",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "cat": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "glyph": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w_m": {
            "type": "number"
          },
          "h_m": {
            "type": "number"
          },
          "brand": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "qty": {
            "type": "number",
            "default": 1
          }
        }
      }
    },
    "observations": {
      "type": "string",
      "description": "Notas del plano"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "enviado",
        "cerrado",
        "cancelado"
      ],
      "default": "borrador"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}