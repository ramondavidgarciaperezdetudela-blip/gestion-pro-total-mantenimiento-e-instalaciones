{
  "name": "PriceItem",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n del trabajo o material"
    },
    "category": {
      "type": "string",
      "enum": [
        "mano_obra",
        "material",
        "desplazamiento",
        "otro"
      ],
      "default": "mano_obra",
      "description": "Categor\u00eda del concepto"
    },
    "unit_price": {
      "type": "number",
      "description": "Precio unitario en euros"
    },
    "unit": {
      "type": "string",
      "default": "ud",
      "description": "Unidad (ud, h, m, m2, kg, etc.)"
    },
    "notes": {
      "type": "string",
      "description": "Notas o detalles adicionales"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nombre del proveedor"
    },
    "supplier_ref": {
      "type": "string",
      "description": "Referencia del proveedor"
    },
    "brand": {
      "type": "string",
      "description": "Marca del producto"
    },
    "image_url": {
      "type": "string",
      "description": "URL de la imagen del producto"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "description",
    "unit_price"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}