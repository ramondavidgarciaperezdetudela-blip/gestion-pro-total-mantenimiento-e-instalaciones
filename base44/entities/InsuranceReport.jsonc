{
  "name": "InsuranceReport",
  "type": "object",
  "properties": {
    "report_number": {
      "type": "string",
      "description": "N\u00famero de informe t\u00e9cnico (autonum\u00e9rico)"
    },
    "contact_id": {
      "type": "string",
      "description": "ID del cliente/asegurado"
    },
    "contact_name": {
      "type": "string",
      "description": "Nombre del cliente/asegurado"
    },
    "insurance_company": {
      "type": "string",
      "description": "Nombre de la compa\u00f1\u00eda aseguradora"
    },
    "insurance_policy": {
      "type": "string",
      "description": "N\u00famero de p\u00f3liza"
    },
    "insurance_claim_ref": {
      "type": "string",
      "description": "Referencia / n\u00famero de siniestro de la aseguradora"
    },
    "claim_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha del siniestro / apertura de la aver\u00eda"
    },
    "report_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de realizaci\u00f3n del informe t\u00e9cnico"
    },
    "report_datetime": {
      "type": "string",
      "description": "Fecha y hora exacta del informe (DD/MM/YYYY HH:MM:SS)"
    },
    "technician": {
      "type": "string",
      "description": "T\u00e9cnico que realiza el informe"
    },
    "equipment_type": {
      "type": "string",
      "enum": [
        "aire_acondicionado",
        "bomba_calor",
        "camara_frigorifica",
        "electrico",
        "solar",
        "fontaneria",
        "otro"
      ],
      "default": "otro"
    },
    "equipment_brand": {
      "type": "string"
    },
    "equipment_model": {
      "type": "string"
    },
    "equipment_serial": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Direcci\u00f3n o ubicaci\u00f3n del equipo inspeccionado"
    },
    "failure_description": {
      "type": "string",
      "description": "Descripci\u00f3n de la aver\u00eda / siniestro declarado"
    },
    "damage_assessment": {
      "type": "string",
      "description": "Valoraci\u00f3n t\u00e9cnica de los da\u00f1os"
    },
    "cause_analysis": {
      "type": "string",
      "description": "Causa probable / an\u00e1lisis t\u00e9cnico del origen"
    },
    "repair_proposal": {
      "type": "string",
      "description": "Propuesta de reparaci\u00f3n / trabajos necesarios"
    },
    "repair_viable": {
      "type": "string",
      "enum": [
        "reparable",
        "irreparable",
        "pendiente_valoracion"
      ],
      "default": "pendiente_valoracion"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Coste estimado de la reparaci\u00f3n (\u20ac)"
    },
    "photos_before": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotos del estado ANTES de la reparaci\u00f3n (max 30)"
    },
    "photos_after": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotos del estado DESPU\u00c9S de la reparaci\u00f3n (max 30)"
    },
    "photos_damage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotos de detalle del da\u00f1o/siniestro (max 30)"
    },
    "materials_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "labor_hours": {
      "type": "number"
    },
    "labor_rate": {
      "type": "number"
    },
    "total": {
      "type": "number"
    },
    "observations": {
      "type": "string"
    },
    "signature_technician": {
      "type": "string",
      "description": "Firma digital del t\u00e9cnico (base64 PNG)"
    },
    "signature_client": {
      "type": "string",
      "description": "Firma digital de conformidad del cliente (base64 PNG)"
    },
    "sign_datetime_technician": {
      "type": "string",
      "description": "Fecha y hora exacta de la firma del t\u00e9cnico (DD/MM/YYYY HH:MM:SS)"
    },
    "sign_datetime_client": {
      "type": "string",
      "description": "Fecha y hora exacta de la firma del cliente (DD/MM/YYYY HH:MM:SS)"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "enviado",
        "firmado",
        "cerrado",
        "cancelado"
      ],
      "default": "borrador"
    }
  },
  "required": [
    "contact_name",
    "report_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}