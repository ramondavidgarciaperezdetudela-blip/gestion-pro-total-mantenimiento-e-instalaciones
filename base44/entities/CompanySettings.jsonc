{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nombre de la empresa"
    },
    "nif": {
      "type": "string",
      "description": "NIF de la empresa"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "availability_config": {
      "type": "object",
      "description": "Horario de trabajo para calcular los huecos libres en la pantalla de Disponibilidad.",
      "properties": {
        "dias_laborables": {
          "type": "array",
          "description": "D\u00edas laborables: 1=lunes \u2026 7=domingo",
          "items": {
            "type": "number"
          }
        },
        "hora_inicio": {
          "type": "string",
          "description": "Hora de inicio de jornada (HH:MM)"
        },
        "hora_fin": {
          "type": "string",
          "description": "Hora de fin de jornada (HH:MM)"
        },
        "descanso_inicio": {
          "type": "string",
          "description": "Inicio de la pausa (HH:MM). Vac\u00edo = sin pausa"
        },
        "descanso_fin": {
          "type": "string",
          "description": "Fin de la pausa (HH:MM)"
        },
        "duracion_cita": {
          "type": "number",
          "description": "Duraci\u00f3n de cada hueco en minutos"
        },
        "dias_vista": {
          "type": "number",
          "description": "D\u00edas de antelaci\u00f3n que se muestran"
        }
      }
    },
    "storage_config": {
      "type": "object",
      "description": "Almac\u00e9n externo de fotos y documentos (Cloudinary). Permite subirlos en calidad completa sin gastar cr\u00e9dito de Base44.",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Proveedor. Por ahora solo 'cloudinary'.",
          "default": "cloudinary"
        },
        "cloud_name": {
          "type": "string",
          "description": "Cloud name de la cuenta de Cloudinary"
        },
        "upload_preset": {
          "type": "string",
          "description": "Nombre del upload preset SIN FIRMAR (unsigned) creado en Cloudinary"
        },
        "enabled": {
          "type": "boolean",
          "description": "Si est\u00e1 activo, las fotos y documentos se suben aqu\u00ed en vez de a Base44",
          "default": false
        }
      }
    },
    "printer_config": {
      "type": "object",
      "properties": {
        "margin_top": {
          "type": "number",
          "default": 10
        },
        "margin_bottom": {
          "type": "number",
          "default": 10
        },
        "margin_left": {
          "type": "number",
          "default": 10
        },
        "margin_right": {
          "type": "number",
          "default": 10
        },
        "paper_size": {
          "type": "string",
          "enum": [
            "A4",
            "A5",
            "Carta"
          ],
          "default": "A4"
        }
      }
    },
    "payment_terms": {
      "type": "string",
      "description": "Condiciones de pago por defecto"
    },
    "observations_climate": {
      "type": "string"
    },
    "observations_electric": {
      "type": "string"
    },
    "observations_refrigeration": {
      "type": "string"
    },
    "technicians": {
      "type": "array",
      "description": "Lista de t\u00e9cnicos del equipo con credenciales",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fgas_carnet": {
            "type": "string",
            "description": "N\u00famero de carnet F-Gas (gases fluorados)"
          },
          "rite_certificate": {
            "type": "string",
            "description": "N\u00famero de certificado RITE (climatizaci\u00f3n)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "public_app_url": {
      "type": "string",
      "description": "Direcci\u00f3n p\u00fablica del programa. Con ella se arma el QR de verificaci\u00f3n de los documentos; sin ella el QR apunta al aparato desde el que se imprime y al cliente no le abre nada"
    },
    "verify_default_days": {
      "type": "number",
      "default": 365,
      "description": "D\u00edas de validez de la verificaci\u00f3n en los documentos nuevos (0 = sin caducidad)"
    }
  },
  "required": [
    "company_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}