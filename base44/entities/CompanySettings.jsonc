{
  "name": "CompanySettings",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "description": "Nombre de la empresa"
    },
    "nif": {
      "type": "string",
      "description": "NIF de la empresa"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string"
    },
    "postal_code": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "availability_config": {
      "type": "object",
      "description": "Horario de trabajo para calcular los huecos libres en la pantalla de Disponibilidad.",
      "properties": {
        "dias_laborables": {
          "type": "array",
          "description": "Días laborables: 1=lunes … 7=domingo",
          "items": { "type": "number" }
        },
        "hora_inicio": { "type": "string", "description": "Hora de inicio de jornada (HH:MM)" },
        "hora_fin": { "type": "string", "description": "Hora de fin de jornada (HH:MM)" },
        "descanso_inicio": { "type": "string", "description": "Inicio de la pausa (HH:MM). Vacío = sin pausa" },
        "descanso_fin": { "type": "string", "description": "Fin de la pausa (HH:MM)" },
        "duracion_cita": { "type": "number", "description": "Duración de cada hueco en minutos" },
        "dias_vista": { "type": "number", "description": "Días de antelación que se muestran" }
      }
    },
    "storage_config": {
      "type": "object",
      "description": "Almacén externo de fotos y documentos (Cloudinary). Permite subirlos en calidad completa sin gastar crédito de Base44.",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Proveedor. Por ahora solo 'cloudinary'.",
          "default": "cloudinary"
        },
        "cloud_name": {
          "type": "string",
          "description": "Cloud name de la cuenta de Cloudinary"
        },
        "upload_preset": {
          "type": "string",
          "description": "Nombre del upload preset SIN FIRMAR (unsigned) creado en Cloudinary"
        },
        "enabled": {
          "type": "boolean",
          "description": "Si está activo, las fotos y documentos se suben aquí en vez de a Base44",
          "default": false
        }
      }
    },
    "printer_config": {
      "type": "object",
      "properties": {
        "margin_top": {
          "type": "number",
          "default": 10
        },
        "margin_bottom": {
          "type": "number",
          "default": 10
        },
        "margin_left": {
          "type": "number",
          "default": 10
        },
        "margin_right": {
          "type": "number",
          "default": 10
        },
        "paper_size": {
          "type": "string",
          "enum": [
            "A4",
            "A5",
            "Carta"
          ],
          "default": "A4"
        }
      }
    },
    "payment_terms": {
      "type": "string",
      "description": "Condiciones de pago por defecto"
    },
    "observations_climate": {
      "type": "string"
    },
    "observations_electric": {
      "type": "string"
    },
    "observations_refrigeration": {
      "type": "string"
    },
    "technicians": {
      "type": "array",
      "description": "Lista de t\u00e9cnicos del equipo con credenciales",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fgas_carnet": {
            "type": "string",
            "description": "N\u00famero de carnet F-Gas (gases fluorados)"
          },
          "rite_certificate": {
            "type": "string",
            "description": "N\u00famero de certificado RITE (climatizaci\u00f3n)"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "public_app_url": {
      "type": "string",
      "description": "Dirección pública del programa. Con ella se arma el QR de verificación de los documentos; sin ella el QR apunta al aparato desde el que se imprime y al cliente no le abre nada"
    },
    "verify_default_days": {
      "type": "number",
      "default": 365,
      "description": "Días de validez de la verificación en los documentos nuevos (0 = sin caducidad)"
    }
  },
  "required": [
    "company_name"
  ]
}