{
  "name": "ClientMachine",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Nombre o descripci\u00f3n del equipo"
    },
    "machine_type": {
      "type": "string",
      "enum": [
        "aire_acondicionado",
        "bomba_calor",
        "camara_frigorifica",
        "ventilacion",
        "caldera",
        "aerotermia",
        "solar_fotovoltaico",
        "solar_termico",
        "electrico_cuadro",
        "grupo_frio",
        "otro"
      ],
      "default": "otro"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "installation_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n del equipo (ej: planta 1, sala t\u00e9cnica)"
    },
    "refrigerant_type": {
      "type": "string"
    },
    "power_kw": {
      "type": "number"
    },
    "warranty_expiry": {
      "type": "string",
      "format": "date"
    },
    "next_maintenance_date": {
      "type": "string",
      "format": "date"
    },
    "maintenance_interval_months": {
      "type": "number",
      "default": 12
    },
    "status": {
      "type": "string",
      "enum": [
        "operativo",
        "en_reparacion",
        "fuera_servicio",
        "baja"
      ],
      "default": "operativo"
    },
    "photo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "refrigerant_charge_kg": {
      "type": "number",
      "description": "Carga de refrigerante (kg)"
    },
    "gwp": {
      "type": "number",
      "description": "PCA / GWP usado en el cálculo"
    },
    "last_leak_check": {
      "type": "string",
      "format": "date"
    },
    "hermetic": {
      "type": "boolean"
    },
    "leak_detection": {
      "type": "boolean",
      "description": "Lleva sistema de detección de fugas"
    },
    "residential": {
      "type": "boolean"
    },
    "oil_type": {
      "type": "string"
    },
    "oil_charge_l": {
      "type": "number"
    },
    "expansion_type": {
      "type": "string"
    },
    "compressor_type": {
      "type": "string"
    },
    "nominal_low_bar": {
      "type": "number"
    },
    "nominal_high_bar": {
      "type": "number"
    },
    "ps_bar": {
      "type": "number",
      "description": "Presión máxima admisible (PS) de placa"
    },
    "sensible_kw": {
      "type": "number"
    },
    "heating_kw": {
      "type": "number"
    },
    "setpoint_cold_c": {
      "type": "number"
    },
    "setpoint_heat_c": {
      "type": "number"
    },
    "humidity_pct": {
      "type": "number"
    },
    "last_maintenance_date": {
      "type": "string",
      "format": "date"
    },
    "maintenance_log": {
      "type": "array",
      "description": "Libro de mantenimiento del equipo",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "technician": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "cost": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "contact_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "kairigardia.gestionprototal@gmail.com"
          }
        }
      ]
    }
  }
}